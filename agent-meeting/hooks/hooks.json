{
  "description": "Agent messaging lifecycle: repair the loopback-first am-msgd user service and inject context on SessionStart.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/session-bootstrap.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/bin/session-bootstrap.py\" || python \"${CLAUDE_PLUGIN_ROOT}/bin/session-bootstrap.py\""
          }
        ]
      }
    ]
  }
}
