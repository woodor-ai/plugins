#!/usr/bin/env python3
"""Compatibility entrypoint for the packaged am-msgd implementation."""

import sys
from pathlib import Path


def _resolve_source_root() -> Path:
    """Find package sources from either the plugin tree or copied Windows shim."""
    local_source = Path(__file__).resolve().parent.parent / "src"
    if local_source.is_dir():
        return local_source

    activation = Path(__file__).resolve().parent.parent / ".bin-plugin-root"
    if activation.is_file():
        plugin_bin = Path(
            activation.read_text(encoding="utf-8").splitlines()[0]
        )
        activated_source = plugin_bin.parent / "src"
        if activated_source.is_dir():
            return activated_source

    raise RuntimeError(
        "am-msgd package source not found; rerun the agent-meeting installer"
    )


_SOURCE_ROOT = _resolve_source_root()
_IMPLEMENTATION = (
    _SOURCE_ROOT
    / "agent_meeting"
    / "message_hub"
    / "message_hub_process.py"
)
sys.path.insert(0, str(_SOURCE_ROOT))

exec(
    compile(
        _IMPLEMENTATION.read_text(encoding="utf-8"),
        str(_IMPLEMENTATION),
        "exec",
    ),
    globals(),
    globals(),
)
