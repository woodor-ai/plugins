{
  "description": "Configure the agent-meeting status line and inject session context on SessionStart.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/claude_session_start.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/claude_session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/claude_session_start.py\""
          }
        ]
      }
    ]
  }
}
